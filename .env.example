SENTINEL_ENVIRONMENT=production
SENTINEL_VERSION=0.1.0
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-use-a-long-random-password
DATABASE_URL=postgresql://sentinel:change-me-use-a-long-random-password@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=change-me-use-at-least-32-random-characters
DATA_ENCRYPTION_KEY=change-me-provide-a-32-byte-base64-key
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
DETAILED_RETENTION_DAYS=30
LOG_LEVEL=INFO
